<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>2027 大阪 7天6夜親子自由行｜日系繪本風行程手冊</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-washi: #FFFCF6;
      --ink: #3E3A39;
      --coral: #F2A497;
      --yamabuki: #F6D27A;
      --mizuiro: #A8D3E6;
      --wakatake: #B9DAA5;
      --white: #FFFFFF;
      --border-w: 2.5px;
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 10px;
      --shadow-hard: 3px 3px 0px #3E3A39;
      --shadow-sm: 1.5px 1.5px 0px #3E3A39;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 14px;
    }

    @media (min-width: 600px) {
      html {
        font-size: 15px;
      }
    }

    html, body {
      height: 100%;
      width: 100%;
      overflow: hidden;
      overscroll-behavior: none;
    }

    body {
      font-family: 'Huninn', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif;
      background-color: var(--bg-washi);
      color: var(--ink);
      line-height: 1.5;
    }

    /* 頂端固定選單（鎖定在視窗最上方，不隨下方內容捲動） */
    .top-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: 68px;
      z-index: 9999;
      background-color: var(--bg-washi);
      border-bottom: var(--border-w) solid var(--ink);
      box-shadow: 0 2px 0px rgba(62, 58, 57, 0.12);
      padding: 6px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      align-content: center;
      gap: 4px;
      flex-wrap: wrap;
    }

    @media (min-width: 600px) {
      .top-nav {
        height: 50px;
      }
    }

    /* 獨立內層捲動區：解決 iPhone 預覽器整頁連動捲動導致上方選單跑掉的問題 */
    .scroll-viewport {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      bottom: 0;
      overflow-y: auto;
      overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scroll-padding-top: 12px;
      background-color: var(--bg-washi);
      background-image: radial-gradient(#E8E0D0 1.2px, transparent 1.2px);
      background-size: 20px 20px;
      padding-bottom: 64px;
    }

    @media (min-width: 600px) {
      .scroll-viewport {
        top: 50px;
      }
    }

    section[id] {
      scroll-margin-top: 12px;
    }

    .nav-brand {
      font-size: 0.98rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-links {
      display: flex;
      gap: 3px;
      flex-wrap: wrap;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--ink);
      background: var(--white);
      border: 1.5px solid var(--ink);
      border-radius: 999px;
      padding: 2.5px 7.5px;
      font-size: 0.76rem;
      box-shadow: var(--shadow-sm);
      transition: transform 0.15s ease;
    }

    @media (min-width: 600px) {
      .nav-links {
        gap: 5px;
      }
      .nav-links a {
        padding: 3px 10px;
        font-size: 0.82rem;
      }
    }

    .nav-links a:active {
      transform: translate(2px, 2px);
      box-shadow: none;
    }

    .container {
      max-width: 680px;
      margin: 0 auto;
      padding: 10px 12px;
    }

    /* 繪本風通用卡片 */
    .book-card {
      background: var(--white);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-hard);
      padding: 14px;
      margin-bottom: 16px;
    }

    .section-title {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 1.12rem;
      background: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 4px 14px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 12px;
    }

    /* 首頁 Hero 區塊 */
    .hero-card {
      background: var(--mizuiro);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .hero-badge {
      display: inline-block;
      background: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 4px 14px;
      font-size: 0.9rem;
      margin-bottom: 10px;
      box-shadow: var(--shadow-sm);
    }

    .hero-title {
      font-size: 1.45rem;
      line-height: 1.25;
      margin-bottom: 4px;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      margin-bottom: 10px;
    }

    .hero-svg-wrap {
      max-width: 270px;
      margin: 0 auto 2px;
      background: var(--bg-washi);
      border: 2px solid var(--ink);
      border-radius: var(--radius-lg);
      padding: 6px;
      box-shadow: var(--shadow-sm);
    }

    /* 輕輕浮動與切換彈跳動畫 */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-5px) rotate(1.5deg); }
    }

    @keyframes swayGentle {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(2deg); }
    }

    @keyframes popBounce {
      0% { transform: scale(0.96) translateY(6px); opacity: 0.5; }
      60% { transform: scale(1.015) translateY(-2px); opacity: 1; }
      100% { transform: scale(1) translateY(0px); opacity: 1; }
    }

    .anim-float {
      animation: floatSlow 3.6s ease-in-out infinite;
      transform-origin: center;
    }

    .anim-sway {
      animation: swayGentle 4s ease-in-out infinite;
      transform-origin: bottom center;
    }

    @media (prefers-reduced-motion: reduce) {
      .anim-float, .anim-sway, .day-panel {
        animation: none !important;
      }
      html {
        scroll-behavior: auto;
      }
    }

    /* 航班卡片（去程與回程左右並排） */
    .flight-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    @media (min-width: 600px) {
      .flight-grid {
        gap: 12px;
      }
    }

    .flight-card {
      background: var(--bg-washi);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 10px 9px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 600px) {
      .flight-card {
        padding: 12px;
      }
    }

    .flight-tag {
      display: inline-block;
      align-self: flex-start;
      padding: 2px 7px;
      border: 1.5px solid var(--ink);
      border-radius: 999px;
      font-size: 0.72rem;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    @media (min-width: 600px) {
      .flight-tag {
        padding: 2px 10px;
        font-size: 0.8rem;
      }
    }

    .tag-out { background: var(--wakatake); }
    .tag-in { background: var(--coral); }

    .flight-airline {
      font-size: 0.86rem;
    }

    .flight-route {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2px;
      margin: 6px 0;
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    @media (min-width: 600px) {
      .flight-route {
        font-size: 1.1rem;
      }
    }

    .flight-meta {
      font-size: 0.78rem;
      line-height: 1.45;
      background: var(--white);
      border: 1.5px dashed var(--ink);
      border-radius: var(--radius-sm);
      padding: 6px 7px;
      margin-top: auto;
    }

    @media (min-width: 600px) {
      .flight-meta {
        font-size: 0.85rem;
        padding: 8px;
      }
    }

    .hotel-inner {
      background: #F1F8EC;
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-md);
      padding: 14px;
      margin-top: 14px;
    }

    /* Google Map 導航按鈕 */
    .map-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: var(--yamabuki);
      color: var(--ink);
      text-decoration: none;
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 0.84rem;
      box-shadow: var(--shadow-sm);
      margin-top: 6px;
      transition: transform 0.12s ease;
    }

    .map-btn:active {
      transform: translate(2px, 2px);
      box-shadow: none;
    }

    /* ===== 純 CSS 日期切換（無 JS 也能 100% 切換）===== */
    .day-radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .day-tabs {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 12px;
    }

    @media (min-width: 600px) {
      .day-tabs {
        grid-template-columns: repeat(7, 1fr);
      }
    }

    .day-tab-btn {
      display: block;
      background: var(--bg-washi);
      color: var(--ink);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 5px 3px;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      text-align: center;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.15s;
    }

    .day-tab-btn:hover {
      transform: translateY(-2px);
    }

    .day-tab-num {
      display: block;
      font-size: 0.95rem;
      font-weight: 700;
    }

    .day-tab-date {
      display: block;
      font-size: 0.75rem;
    }

    /* 選中時按鈕高亮 */
    #radio-day-1:checked ~ .day-tabs #tab-lbl-1,
    #radio-day-2:checked ~ .day-tabs #tab-lbl-2,
    #radio-day-3:checked ~ .day-tabs #tab-lbl-3,
    #radio-day-4:checked ~ .day-tabs #tab-lbl-4,
    #radio-day-5:checked ~ .day-tabs #tab-lbl-5,
    #radio-day-6:checked ~ .day-tabs #tab-lbl-6,
    #radio-day-7:checked ~ .day-tabs #tab-lbl-7 {
      background: var(--coral);
      transform: translateY(-3px) scale(1.03);
    }

    /* 預設隱藏面板，選中時顯示並彈跳 */
    .day-panel {
      display: none;
    }

    #radio-day-1:checked ~ .day-panels #panel-day-1,
    #radio-day-2:checked ~ .day-panels #panel-day-2,
    #radio-day-3:checked ~ .day-panels #panel-day-3,
    #radio-day-4:checked ~ .day-panels #panel-day-4,
    #radio-day-5:checked ~ .day-panels #panel-day-5,
    #radio-day-6:checked ~ .day-panels #panel-day-6,
    #radio-day-7:checked ~ .day-panels #panel-day-7 {
      display: block;
      animation: popBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* 每日行程標題與插圖 */
    .day-header {
      background: var(--mizuiro);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .day-header-text {
      flex: 1;
      min-width: 200px;
    }

    .day-header-text h3 {
      font-size: 1.18rem;
      margin-bottom: 4px;
    }

    .day-illust {
      width: 74px;
      height: 64px;
      background: var(--bg-washi);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* 時間軸 */
    .timeline {
      position: relative;
      padding-left: 16px;
      border-left: 2.5px dashed var(--ink);
      margin-left: 6px;
    }

    .tl-item {
      position: relative;
      background: var(--bg-washi);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 10px 11px;
      margin-bottom: 10px;
      box-shadow: var(--shadow-sm);
    }

    .tl-item::before {
      content: "";
      position: absolute;
      left: -23px;
      top: 13px;
      width: 11px;
      height: 11px;
      background: var(--yamabuki);
      border: 2.5px solid var(--ink);
      border-radius: 50%;
    }

    .tl-top {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }

    .tl-time {
      background: var(--ink);
      color: var(--bg-washi);
      border-radius: 999px;
      padding: 2px 10px;
      font-size: 0.82rem;
    }

    /* 交通彩色小標籤 */
    .transport-pill {
      display: inline-block;
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 1px 10px;
      font-size: 0.8rem;
    }

    .tr-jr { background: var(--mizuiro); }
    .tr-metro { background: var(--coral); }
    .tr-bus { background: var(--wakatake); }
    .tr-taxi { background: var(--yamabuki); }
    .tr-walk { background: var(--white); }

    .tl-title {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .tl-desc {
      font-size: 0.92rem;
    }

    /* 避坑提醒框 */
    .pitfall-box {
      background: #FFF3D6;
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      padding: 9px 12px;
      margin-top: 8px;
      font-size: 0.88rem;
    }

    .pitfall-badge {
      display: inline-block;
      background: var(--coral);
      border: 2px solid var(--ink);
      border-radius: 8px;
      padding: 0 7px;
      font-size: 0.78rem;
      margin-right: 4px;
    }

    /* 日程底部切換鈕 */
    .day-nav-footer {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 14px;
    }

    .nav-step-btn {
      display: inline-block;
      background: var(--yamabuki);
      color: var(--ink);
      border: var(--border-w) solid var(--ink);
      border-radius: 999px;
      padding: 8px 16px;
      font-size: 0.92rem;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      user-select: none;
    }

    .nav-step-btn.disabled {
      opacity: 0.4;
      cursor: default;
      box-shadow: none;
    }

    /* 勾選清單與兩家切換 */
    .family-switch {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }

    /* ===== 純 CSS 兩家人切換（無 JS 預覽器也能 100% 切換與打勾）===== */
    .fam-radio {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .fam-btn {
      display: block;
      text-align: center;
      font-family: inherit;
      flex: 1;
      padding: 6px;
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      background: var(--bg-washi);
      cursor: pointer;
      font-size: 0.9rem;
      box-shadow: var(--shadow-sm);
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      transition: background-color 0.15s, transform 0.12s;
    }

    #fam-radio-1:checked ~ #todo .fam-lbl-1,
    #fam-radio-1:checked ~ #packing .fam-lbl-1,
    #fam-radio-2:checked ~ #todo .fam-lbl-2,
    #fam-radio-2:checked ~ #packing .fam-lbl-2 {
      background: var(--wakatake);
      font-weight: 700;
      transform: translateY(-2px);
    }

    .fam-panel-1,
    .fam-panel-2 {
      display: none;
    }

    #fam-radio-1:checked ~ #todo .fam-panel-1,
    #fam-radio-1:checked ~ #packing .fam-panel-1 {
      display: block;
      animation: popBounce 0.28s ease;
    }

    #fam-radio-2:checked ~ #todo .fam-panel-2,
    #fam-radio-2:checked ~ #packing .fam-panel-2 {
      display: block;
      animation: popBounce 0.28s ease;
    }

    .checklist-group {
      margin-bottom: 12px;
    }

    .checklist-group h4 {
      font-size: 0.95rem;
      margin-bottom: 6px;
      padding-left: 6px;
      border-left: 4px solid var(--coral);
    }

    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      background: var(--bg-washi);
      border: 1.5px solid var(--ink);
      border-radius: var(--radius-sm);
      padding: 7px 10px;
      margin-bottom: 6px;
      font-size: 0.92rem;
      cursor: pointer;
      user-select: none;
    }

    .check-item input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 19px;
      height: 19px;
      border: 2px solid var(--ink);
      border-radius: 5px;
      background: var(--white);
      flex-shrink: 0;
      margin-top: 1px;
      position: relative;
      cursor: pointer;
    }

    .check-item input[type="checkbox"]:checked {
      background: var(--wakatake);
    }

    .check-item input[type="checkbox"]:checked::after {
      content: "✓";
      position: absolute;
      top: -3px;
      left: 2.5px;
      font-size: 14px;
      font-weight: 700;
      color: var(--ink);
    }

    .check-item.done span,
    .check-item:has(input[type="checkbox"]:checked) span {
      text-decoration: line-through;
      opacity: 0.6;
    }

    @property --todo-done {
      syntax: "<integer>";
      initial-value: 0;
      inherits: true;
    }

    @property --pack-done {
      syntax: "<integer>";
      initial-value: 0;
      inherits: true;
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 5px;
      padding: 0 2px;
    }

    .progress-badge {
      background: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 1px 10px;
      font-size: 0.8rem;
    }

    .progress-bar-wrap {
      background: var(--bg-washi);
      border: 2px solid var(--ink);
      border-radius: 999px;
      height: 15px;
      overflow: hidden;
      margin-bottom: 10px;
      box-shadow: inset 0 2px 0 rgba(62, 58, 57, 0.08);
    }

    .progress-bar-fill {
      height: 100%;
      background: repeating-linear-gradient(
        -45deg,
        var(--coral),
        var(--coral) 10px,
        #F6B7AC 10px,
        #F6B7AC 20px
      );
      border-right: 2px solid var(--ink);
      width: 0%;
      transition: width 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .progress-bar-fill[style*="width: 0%"],
    .progress-bar-fill.is-zero {
      border-right: none;
    }

    /* 純 CSS 即時計算待辦清單勾選進度（免 JS 預覽器也 100% 同步連動） */
    #todo .fam-panel-1,
    #todo .fam-panel-2 {
      --t1: 0; --t2: 0; --t3: 0; --t4: 0; --t5: 0; --t6: 0;
      --t7: 0; --t8: 0; --t9: 0; --t10: 0; --t11: 0; --t12: 0;
      --todo-done: calc(var(--t1) + var(--t2) + var(--t3) + var(--t4) + var(--t5) + var(--t6) + var(--t7) + var(--t8) + var(--t9) + var(--t10) + var(--t11) + var(--t12));
      counter-reset: todo-done var(--todo-done);
    }
    #todo .fam-panel-1:has(input[data-item-id="t1"]:checked), #todo .fam-panel-2:has(input[data-item-id="t1"]:checked) { --t1: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t2"]:checked), #todo .fam-panel-2:has(input[data-item-id="t2"]:checked) { --t2: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t3"]:checked), #todo .fam-panel-2:has(input[data-item-id="t3"]:checked) { --t3: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t4"]:checked), #todo .fam-panel-2:has(input[data-item-id="t4"]:checked) { --t4: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t5"]:checked), #todo .fam-panel-2:has(input[data-item-id="t5"]:checked) { --t5: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t6"]:checked), #todo .fam-panel-2:has(input[data-item-id="t6"]:checked) { --t6: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t7"]:checked), #todo .fam-panel-2:has(input[data-item-id="t7"]:checked) { --t7: 1; }
    #todo .fam-panel-1:has(input[data-item-id="t8"]:checked), #todo .fam-panel-2:has(input[data-item-id="t8"]:checked) { --t8: 1; }
