    /* ===== 日幣轉換台幣計算機（支援自行輸入雙向換算 + 無 JS 純 CSS 備援）===== */
    @property --fx-jpy-val {
      syntax: "<integer>";
      initial-value: 1000;
      inherits: true;
    }

    @property --fx-twd-val {
      syntax: "<integer>";
      initial-value: 206;
      inherits: true;
    }

    #currency {
      --fx-base: 1000;
      --fx-c100: 0;
      --fx-c500: 0;
      --fx-c1000: 0;
      --fx-c2000: 0;
      --fx-c5000: 0;
      --fx-c10000: 0;
      --fx-rate-milli: 206;
      --fx-jpy-val: calc(var(--fx-base) + var(--fx-c100) + var(--fx-c500) + var(--fx-c1000) + var(--fx-c2000) + var(--fx-c5000) + var(--fx-c10000));
      --fx-twd-val: calc(var(--fx-jpy-val) * var(--fx-rate-milli) / 1000);
      counter-reset: fx-jpy var(--fx-jpy-val) fx-twd var(--fx-twd-val);
    }

    #currency:has(#fx-pre-0:checked) { --fx-base: 0; }
    #currency:has(#fx-pre-300:checked) { --fx-base: 300; }
    #currency:has(#fx-pre-1000:checked) { --fx-base: 1000; }
    #currency:has(#fx-pre-3000:checked) { --fx-base: 3000; }
    #currency:has(#fx-pre-5500:checked) { --fx-base: 5500; }
    #currency:has(#fx-pre-10000:checked) { --fx-base: 10000; }

    #currency:has(#fx-chip-100:checked) { --fx-c100: 100; }
    #currency:has(#fx-chip-500:checked) { --fx-c500: 500; }
    #currency:has(#fx-chip-1000:checked) { --fx-c1000: 1000; }
    #currency:has(#fx-chip-2000:checked) { --fx-c2000: 2000; }
    #currency:has(#fx-chip-5000:checked) { --fx-c5000: 5000; }
    #currency:has(#fx-chip-10000:checked) { --fx-c10000: 10000; }

    .fx-hidden-ctrl {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

