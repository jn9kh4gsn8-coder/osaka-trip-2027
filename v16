  <script>
    // 1. 日幣 ⇄ 台幣 自行輸入雙向換算機（含自訂匯率、免稅試算與累加功能）
    (function initCurrencyConverter() {
      const section = document.getElementById('currency');
      const jpyInput = document.getElementById('fx-jpy-input');
      const twdInput = document.getElementById('fx-twd-input');
      const rateInput = document.getElementById('fx-rate-input');
      const rateResetBtn = document.getElementById('fx-rate-reset');
      const clearBtn = document.getElementById('fx-clear-btn');
      const taxHint = document.getElementById('fx-tax-hint');
      if (!section || !jpyInput || !twdInput || !rateInput) return;

      const DEFAULT_RATE = 0.206;
      const RATE_STORAGE_KEY = 'osaka_2027_fx_rate';

      // 啟用 JS 互動輸入模式（自動隱藏純 CSS 備援）
      section.classList.add('js-fx-ready');

      function getRate() {
        const val = parseFloat(rateInput.value);
        return (Number.isFinite(val) && val > 0) ? val : DEFAULT_RATE;
      }

      // 載入記憶的匯率
      try {
        const savedRate = parseFloat(localStorage.getItem(RATE_STORAGE_KEY));
        if (Number.isFinite(savedRate) && savedRate > 0) {
          rateInput.value = savedRate;
        }
      } catch (e) {}

      function formatInt(num) {
        return Math.round(num).toLocaleString('zh-TW');
      }

      function updateTaxHint(jpyVal, rate) {
        if (!taxHint) return;
        const jpy = Number(jpyVal) || 0;
        if (jpy <= 0) {
          taxHint.classList.remove('is-taxfree');
          taxHint.innerHTML = '💡 直接在日幣或台幣欄輸入金額，即可即時換算與試算退稅！';
        } else if (jpy >= 5500) {
          const taxFreeJpy = Math.round(jpy / 1.1);
          const taxFreeTwd = Math.round(taxFreeJpy * rate);
          const savedTwd = Math.max(0, Math.round(jpy * rate) - taxFreeTwd);
          taxHint.classList.add('is-taxfree');
          taxHint.innerHTML = `✅ 已達 ¥5,500 免稅門檻！退稅後約 <strong>¥${formatInt(taxFreeJpy)}</strong>（約 NT$ ${formatInt(taxFreeTwd)}，現省約 NT$ ${formatInt(savedTwd)}）`;
        } else {
          const diffJpy = 5500 - Math.round(jpy);
          const diffTwd = Math.round(diffJpy * rate);
          taxHint.classList.remove('is-taxfree');
          taxHint.innerHTML = `🛍️ 距離 ¥5,500 免稅門檻還差 <strong>¥${formatInt(diffJpy)}</strong>（約 NT$ ${formatInt(diffTwd)}）`;
        }
      }

      function updateRefTable(rate) {
        document.querySelectorAll('#fx-ref-table [data-ref-jpy]').forEach(el => {
          const jpy = parseFloat(el.dataset.refJpy) || 0;
          el.textContent = `NT$${formatInt(jpy * rate)}`;
        });
      }

      function syncFromJpy() {
        const rate = getRate();
        const raw = jpyInput.value.trim();
        if (raw === '') {
          twdInput.value = '';
          updateTaxHint(0, rate);
          return;
        }
        const jpy = Math.max(0, parseFloat(raw) || 0);
        twdInput.value = Math.round(jpy * rate);
        updateTaxHint(jpy, rate);
      }

      function syncFromTwd() {
        const rate = getRate();
        const raw = twdInput.value.trim();
        if (raw === '') {
          jpyInput.value = '';
          updateTaxHint(0, rate);
          return;
        }
        const twd = Math.max(0, parseFloat(raw) || 0);
        const jpy = Math.round(twd / rate);
        jpyInput.value = jpy;
        updateTaxHint(jpy, rate);
      }

      jpyInput.addEventListener('input', syncFromJpy);
      twdInput.addEventListener('input', syncFromTwd);

      // 點選輸入框時自動全選，方便直接覆寫數字
      jpyInput.addEventListener('focus', () => jpyInput.select());
      twdInput.addEventListener('focus', () => twdInput.select());

      rateInput.addEventListener('input', () => {
        const val = parseFloat(rateInput.value);
        if (Number.isFinite(val) && val > 0) {
          try { localStorage.setItem(RATE_STORAGE_KEY, String(val)); } catch (e) {}
          updateRefTable(val);
          syncFromJpy();
        }
      });

      if (rateResetBtn) {
        rateResetBtn.addEventListener('click', () => {
          rateInput.value = DEFAULT_RATE;
          try { localStorage.setItem(RATE_STORAGE_KEY, String(DEFAULT_RATE)); } catch (e) {}
          updateRefTable(DEFAULT_RATE);
          syncFromJpy();
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          jpyInput.value = '';
          twdInput.value = '';
          updateTaxHint(0, getRate());
          jpyInput.focus();
        });
      }

      // 常用金額快選按鈕
      section.querySelectorAll('[data-fx-set]').forEach(btn => {
        btn.addEventListener('click', () => {
          const val = parseInt(btn.dataset.fxSet, 10) || 0;
          if (val === 0) {
            jpyInput.value = '';
            twdInput.value = '';
            updateTaxHint(0, getRate());
          } else {
            jpyInput.value = val;
            syncFromJpy();
          }
        });
      });

      // 累加按鈕（可連續點擊加總）
      section.querySelectorAll('[data-fx-add]').forEach(btn => {
        btn.addEventListener('click', () => {
          const addVal = parseInt(btn.dataset.fxAdd, 10) || 0;
          const current = Math.max(0, parseFloat(jpyInput.value) || 0);
          jpyInput.value = Math.round(current + addVal);
          syncFromJpy();
        });
      });

      // 初始化顯示
      updateRefTable(getRate());
      syncFromJpy();
    })();

    // 2. 動態對齊頂端選單高度 + 內層捲動容器導航
    const topNavEl = document.querySelector('.top-nav');
    const viewportEl = document.getElementById('scroll-viewport');

    function syncViewportOffset() {
      if (topNavEl && viewportEl) {
        viewportEl.style.top = topNavEl.offsetHeight + 'px';
      }
    }
    syncViewportOffset();
    window.addEventListener('resize', syncViewportOffset);

    // 若特定預覽器仍強制捲動外層視窗，同步補償頂部選單位置
    window.addEventListener('scroll', () => {
      if (topNavEl && window.scrollY > 0) {
        topNavEl.style.transform = `translateY(${window.scrollY}px)`;
      } else if (topNavEl) {
        topNavEl.style.transform = '';
      }
    }, { passive: true });

    // 點擊頂端選單平滑捲動內層視窗
    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && href.startsWith('#') && viewportEl) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            const topPos = target.offsetTop - 12;
            viewportEl.scrollTo({ top: Math.max(0, topPos), behavior: 'smooth' });
          }
        }
      });
    });

    // 點擊底部「上一天／下一天」時自動捲回行程頂端
    document.querySelectorAll('.day-nav-footer label.nav-step-btn').forEach(lbl => {
      lbl.addEventListener('click', () => {
        const target = document.getElementById('itinerary');
        if (target && viewportEl) {
          setTimeout(() => {
            viewportEl.scrollTo({ top: Math.max(0, target.offsetTop - 12), behavior: 'smooth' });
          }, 30);
        }
      });
    });

    // 3. 兩家人獨立儲存的待辦與行李清單（搭配純 CSS 雙面板預渲染）
    function getActiveFamily() {
      const r2 = document.getElementById('fam-radio-2');
      return (r2 && r2.checked) ? 'fam2' : 'fam1';
    }

    function getStorageKey(fam) {
      return `osaka_2027_checklist_${fam}`;
    }

    function loadCheckedState(fam) {
      try {
        return JSON.parse(localStorage.getItem(getStorageKey(fam))) || {};
      } catch (e) {
        return {};
      }
    }

    function saveCheckedState(fam, state) {
      try {
        localStorage.setItem(getStorageKey(fam), JSON.stringify(state));
      } catch (e) {}
    }

    function updateProgressBar() {
      // 進度條已由純 CSS :has() 即時自動計算，確保任何預覽器皆同步更新
    }

    function syncAllCheckboxesFromStorage() {
      ['fam1', 'fam2'].forEach(fam => {
        const state = loadCheckedState(fam);
        const checkboxes = document.querySelectorAll(`input[type="checkbox"][data-fam="${fam}"]`);
        checkboxes.forEach(cb => {
          const id = cb.dataset.itemId;
          const isChecked = !!state[id];
          cb.checked = isChecked;
          const parentLabel = cb.closest('.check-item');
          if (parentLabel) {
            parentLabel.classList.toggle('done', isChecked);
          }
        });
      });
      updateProgressBar();
    }

    document.querySelectorAll('input[type="checkbox"][data-item-id]').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const fam = e.target.dataset.fam || getActiveFamily();
        const id = e.target.dataset.itemId;
        const latest = loadCheckedState(fam);
        latest[id] = e.target.checked;
        saveCheckedState(fam, latest);
        const parentLabel = e.target.closest('.check-item');
        if (parentLabel) {
          parentLabel.classList.toggle('done', e.target.checked);
        }
        updateProgressBar();
      });
    });

    document.querySelectorAll('input[name="fam-radio"]').forEach(radio => {
      radio.addEventListener('change', updateProgressBar);
    });

    syncAllCheckboxesFromStorage();

  </script>
</body>
</html>